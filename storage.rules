rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Global default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Isolated patient medical documents
    match /patients/{patientId}/documents/{documentId} {
      // Only patient can upload their own documents (max 15MB, PDF/images)
      allow write: if request.auth != null 
        && request.auth.uid == patientId
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('application/pdf') || request.resource.contentType.matches('image/.*'));

      // Patient can read their documents; linked physiotherapists read via backend proxy
      allow read: if request.auth != null && request.auth.uid == patientId;
      
      allow delete: if request.auth != null && request.auth.uid == patientId;
    }
  }
}
